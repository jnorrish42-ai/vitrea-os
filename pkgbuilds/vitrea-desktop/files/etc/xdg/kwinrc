[org.kde.kdecoration2]
# plain Breeze title bars: monochrome minimise / maximise / close on the right
library=org.kde.breeze
theme=Breeze
ButtonsOnLeft=
ButtonsOnRight=IAX
BorderSize=None
BorderSizeAuto=false

[Desktops]
Number=4
Rows=1

[Plugins]
# Liquid Glass (kwin-effects-glass) replaces the stock blur + contrast effects.
# vitrea-glass-guard switches back to plain blur on machines without GPU acceleration.
blurEnabled=false
contrastEnabled=false
glassEnabled=true
# fluid animations: scale in/out, squash to the dock, slide between workspaces
scaleEnabled=true
squashEnabled=true
magiclampEnabled=false
slideEnabled=true
maximizeEnabled=true
fadingpopupsEnabled=true
slidingpopupsEnabled=true
wobblywindowsEnabled=false
overviewEnabled=true
# pinch four fingers on the touchpad for Overview (usr/share/kwin/scripts/vitrea-gestures)
vitrea-gesturesEnabled=true

[Effect-blurplus]
# glass (refraction, rim light) on the top bar and dock only; menus and popups just get a soft blur
RefractionExcludeWindows=true
RefractionExcludeMenus=true
RefractionExcludeTooltips=true
RefractionExcludeOSD=true
BlurStrength=5
DockBlurStrength=3
DecorationBlurStrength=5
BlurMenus=true
BlurDocks=true
BlurMatching=false
BlurNonMatching=false
Saturation=1.10
RefractionStrength=10
RefractionEdgeSize=14
RefractionNormalPow=4
RefractionRGBFringing=2
RefractionOffsetStrength=8
RefractionBevelIntensity=10
EdgeLighting=false
EdgeLightingDock=true
RimSpecular=true
RimSpecularScale=6
RimWidth=18
CursorRim=false
CursorRimStrength=50
SquircleCorners=true
EdgeShading=false
EdgeShadowStrength=40
UseDeclaredCornerRadius=true
DockCornerRadius=16
MenuCornerRadius=14
TopCornerRadius=12
BottomCornerRadius=12
SeparateNotificationCorners=true
NotificationTopCornerRadius=16
NotificationBottomCornerRadius=16

[Effect-slide]
HorizontalGap=48
SlideBackground=false

[Effect-wobblywindows]
Stiffness=8
Drag=85
WobblynessLevel=1

[Effect-overview]
BorderActivate=9

[ElectricBorders]
TopLeft=None

[Windows]
BorderlessMaximizedWindows=false

[NightColor]
# warmer screen in the evening; the times are in knighttimerc
Active=true
NightTemperature=4200
