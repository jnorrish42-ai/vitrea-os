#!/bin/bash
# Runs at every boot before the login screen (vitrea-hardware.service) and records what kind of
# machine this is in /run/vitrea/hardware, for the login screen and /usr/lib/vitrea/user-setup:
#   touch=1  a touchscreen: the on-screen keyboard (plasma-keyboard) is used, also at login
#   lite=1   a low-power computer (little memory, or a Pentium/Celeron/Atom/Core m/Y-series CPU):
#            Vitrea turns on its light mode for new users (see /usr/lib/vitrea/lite)
mkdir -p /run/vitrea
udevadm settle --timeout=5 >/dev/null 2>&1 || true

touch=0
for dev in /dev/input/event*; do
    udevadm info --query=property --name="$dev" 2>/dev/null | grep -q '^ID_INPUT_TOUCHSCREEN=1' && { touch=1; break; }
done

lite=0
mem_mb=$(awk '/^MemTotal:/ {print int($2 / 1024)}' /proc/meminfo)
threads=$(nproc)
cpu=$(grep -m1 '^model name' /proc/cpuinfo | cut -d: -f2-)
if [ "$mem_mb" -le 4600 ]; then
    lite=1
elif [ "$threads" -le 4 ] && echo "$cpu" | grep -qiE 'pentium|celeron|atom|core\(tm\) m[0-9]|core m[0-9]|[0-9]{4,5}Y\b|[0-9]Y[0-9]{2}\b'; then
    lite=1
fi
printf 'touch=%s\nlite=%s\n' "$touch" "$lite" > /run/vitrea/hardware

# login screen: start the on-screen keyboard with it on touchscreens
conf=/etc/sddm.conf.d/20-vitrea-touch.conf
if [ $touch = 1 ] && [ -x /usr/bin/plasma-keyboard ]; then
    cat > "$conf" <<'CONF'
# written by /usr/lib/vitrea/hardware-setup: this computer has a touchscreen
[Wayland]
CompositorCommand=kwin_wayland --drm --no-lockscreen --no-global-shortcuts --locale1 --inputmethod plasma-keyboard
CONF
else
    rm -f "$conf"
fi
exit 0
