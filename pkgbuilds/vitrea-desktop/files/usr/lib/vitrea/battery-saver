#!/bin/bash
# While a laptop runs on battery, switch off the GPU-heavy desktop effects (glass, blur, wobbly
# windows); switch them back on when it is plugged in. Nothing is written to the settings, the
# effects are just unloaded from KWin for the time being.
# Started at login (/etc/xdg/autostart/vitrea-battery-saver.desktop) on computers with a battery;
# off with  [Performance] LiteOnBattery=false  in ~/.config/vitrearc (Vitrea Style > Performance).
ls /sys/class/power_supply/*/type 2>/dev/null | xargs -r grep -l Battery >/dev/null 2>&1 || exit 0
[ "$(kreadconfig6 --file vitrearc --group Performance --key LiteOnBattery --default true)" = true ] || exit 0

EFFECTS="glass blur contrast wobblywindows magiclamp"
state="${XDG_RUNTIME_DIR:-/tmp}/vitrea-battery-effects"
on_battery() { [ "$(busctl get-property org.freedesktop.UPower /org/freedesktop/UPower org.freedesktop.UPower OnBattery 2>/dev/null)" = "b true" ]; }
loaded() { qdbus6 org.kde.KWin /Effects org.kde.kwin.Effects.isEffectLoaded "$1" 2>/dev/null; }

apply() {
    if on_battery; then
        [ -f "$state" ] && return
        : > "$state"
        for e in $EFFECTS; do
            if [ "$(loaded $e)" = true ]; then
                echo $e >> "$state"
                qdbus6 org.kde.KWin /Effects org.kde.kwin.Effects.unloadEffect $e >/dev/null 2>&1
            fi
        done
    elif [ -f "$state" ]; then
        while read -r e; do qdbus6 org.kde.KWin /Effects org.kde.kwin.Effects.loadEffect "$e" >/dev/null 2>&1; done < "$state"
        rm -f "$state"
    fi
}

sleep 20       # let KWin finish starting
apply
dbus-monitor --system "type='signal',sender='org.freedesktop.UPower',interface='org.freedesktop.DBus.Properties',member='PropertiesChanged',path='/org/freedesktop/UPower'" 2>/dev/null |
while read -r line; do
    case "$line" in *OnBattery*) sleep 1; apply ;; esac
done
