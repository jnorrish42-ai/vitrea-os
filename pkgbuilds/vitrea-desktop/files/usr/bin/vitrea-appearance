#!/bin/bash
# Switch Vitrea between light and dark: vitrea-appearance [light|dark|toggle]
mode=${1:-toggle}
cur=$(kreadconfig6 --group General --key ColorScheme)
if [ "$mode" = toggle ]; then [[ $cur == *Dark* || $cur == *Night* ]] && mode=light || mode=dark; fi
if [ "$mode" = dark ]; then cs=VitreaDark; else cs=VitreaLight; fi
plasma-apply-colorscheme "$cs" >/dev/null 2>&1 || true
kwriteconfig6 --file kdeglobals --group Icons --key Theme "$([ "$mode" = dark ] && echo Papirus-Dark || echo Papirus)"
kwriteconfig6 --file kwinrc --group org.kde.kdecoration2 --key library org.kde.breeze
kwriteconfig6 --file kwinrc --group org.kde.kdecoration2 --key theme Breeze
dbus-send --session --type=signal /KWin org.kde.KWin.reloadConfig >/dev/null 2>&1 || true
