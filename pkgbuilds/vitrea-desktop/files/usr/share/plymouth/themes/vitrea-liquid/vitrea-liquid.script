// Vitrea boot splash (Plymouth script module): the logo fades in on a dark background,
// with a thin line below it that fills with boot progress. Asks for the disk password when
// the disk is encrypted.

W = Window.GetWidth(); H = Window.GetHeight();
OX = Window.GetX(); OY = Window.GetY();
Window.SetBackgroundTopColor(0.067, 0.067, 0.071);
Window.SetBackgroundBottomColor(0.067, 0.067, 0.071);

if (H > 1300) logo_img = Image("logo-240.png"); else logo_img = Image("logo-160.png");
LS = logo_img.GetWidth();
CX = OX + W / 2;
CY = OY + H * 0.45;

logo = Sprite(logo_img);
logo.SetPosition(CX - LS / 2, CY - LS / 2, 5);
logo.SetOpacity(0);

// ---- progress line ----
mode = Plymouth.GetMode();
show_bar = 1;
if (mode == "shutdown" || mode == "reboot") show_bar = 0;
track_img = Image("track.png");
fill_src = Image("fill.png");
BW = track_img.GetWidth();
BX = CX - BW / 2;
BY = CY + LS / 2 + 56;
track = Sprite(track_img);
track.SetPosition(BX, BY, 3);
track.SetOpacity(0);
fill = Sprite();
fill.SetPosition(BX, BY, 4);
progress = 0; shown = 0; last_w = 0;

// ---- password ----
entry_img = Image("entry.png");
EW = entry_img.GetWidth(); EH = entry_img.GetHeight();
EX = CX - EW / 2; EY = BY - EH / 2;
entry = Sprite(entry_img); entry.SetPosition(EX, EY, 10); entry.SetOpacity(0);
prompt = Sprite(); prompt.SetOpacity(0);
bullet_img = Image("bullet.png");
nb = 0;
dialog = 0;

msg = Sprite(); msg.SetOpacity(0);

t = 0;
fun refresh() {
    t++;
    // fade in over about a second
    k = t / 50;
    if (k > 1) k = 1;
    e = k * k * (3 - 2 * k);
    logo.SetOpacity(e);

    if (shown < progress) shown = shown + (progress - shown) * 0.1;
    if (show_bar && !dialog) {
        track.SetOpacity(e);
        w = Math.Int(BW * shown);
        if (w > 2 && w != last_w) {
            fill.SetImage(fill_src.Scale(w, fill_src.GetHeight()));
            last_w = w;
        }
        if (w > 2) fill.SetOpacity(e);
    } else {
        track.SetOpacity(0);
        fill.SetOpacity(0);
    }
}
Plymouth.SetRefreshFunction(refresh);

fun boot_progress(duration, p) {
    progress = p;
}
Plymouth.SetBootProgressFunction(boot_progress);

fun display_password(text, bullets) {
    dialog = 1;
    entry.SetOpacity(1);
    prompt.SetImage(Image.Text(text, 0.85, 0.85, 0.87, 1, "Sans 12"));
    prompt.SetPosition(CX - prompt.GetImage().GetWidth() / 2, EY - 32, 10);
    prompt.SetOpacity(1);
    if (bullets > 20) bullets = 20;
    for (i = 0; i < bullets || i < nb; i++) {
        if (!bul[i]) bul[i] = Sprite(bullet_img);
        bul[i].SetPosition(EX + 16 + i * 14, EY + (EH - 10) / 2, 11);
        if (i < bullets) bul[i].SetOpacity(1); else bul[i].SetOpacity(0);
    }
    if (bullets > nb) nb = bullets;
}
Plymouth.SetDisplayPasswordFunction(display_password);

fun display_normal() {
    dialog = 0;
    entry.SetOpacity(0);
    prompt.SetOpacity(0);
    for (i = 0; i < nb; i++) bul[i].SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(display_normal);

fun message(text) {
    msg.SetImage(Image.Text(text, 0.75, 0.75, 0.77, 1, "Sans 11"));
    msg.SetPosition(CX - msg.GetImage().GetWidth() / 2, OY + H - 70, 10);
    msg.SetOpacity(1);
}
Plymouth.SetMessageFunction(message);
