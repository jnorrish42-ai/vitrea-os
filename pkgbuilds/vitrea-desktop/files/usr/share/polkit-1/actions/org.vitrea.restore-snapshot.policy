<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Vitrea OS</vendor>
  <action id="org.vitrea.restore-snapshot">
    <description>Restore an earlier version of the system</description>
    <message>Restoring an earlier version of Vitrea needs your password.</message>
    <icon_name>vitrea-logo</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/vitrea/restore-snapshot</annotate>
  </action>
</policyconfig>
