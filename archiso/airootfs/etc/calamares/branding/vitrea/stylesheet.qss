/* Vitrea installer */
#sidebarApp { background-color: #1c1c1e; border-right: 1px solid #2c2c2f; }
#sidebarMenuApp { background-color: transparent; font-size: 15px; }
QPushButton#view-button-back, QPushButton#view-button-next, QPushButton#view-button-cancel {
    min-height: 30px; padding: 4px 18px; border-radius: 10px;
    border: 1px solid #48484c; background-color: #2c2c2f; color: #e8e8ea;
}
QPushButton#view-button-back:hover, QPushButton#view-button-cancel:hover { background-color: #48484c; }
QPushButton#view-button-next { color: #ffffff; border: 0; background-color: #2f7bd6; font-weight: bold; }
QPushButton#view-button-next:hover { background-color: #3b8ae6; }
QPushButton#view-button-back:disabled, QPushButton#view-button-next:disabled { color: #77777c; background-color: #232325; }
QLineEdit { border-radius: 8px; padding: 4px 8px; }
