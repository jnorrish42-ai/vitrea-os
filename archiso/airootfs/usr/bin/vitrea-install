#!/bin/sh
# Launch the graphical installer as root, keeping the desktop session's environment.
# QT_QUICK_BACKEND=software: Calamares embeds a QML slideshow; if OpenGL isn't usable for
# root (common in VMs) Qt would otherwise draw an empty window.
exec sudo -E LANG="${LANG:-en_US.UTF-8}" QT_QUICK_BACKEND=software calamares -D6 "$@"
