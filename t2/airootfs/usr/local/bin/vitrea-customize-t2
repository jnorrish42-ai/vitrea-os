#!/bin/bash
# T2 Mac edition: build-time extras, called from vitrea-customize.
set -e
# Keep receiving linux-t2 and the T2 tools after install
if ! grep -q '^\[arch-mact2\]' /etc/pacman.conf; then
  cat >> /etc/pacman.conf <<'CONF'

# T2 Mac support (t2linux): linux-t2 kernel, audio config, fan daemon, Touch Bar
[arch-mact2]
SigLevel = Never
Include = /etc/pacman.d/arch-mact2-mirrorlist
CONF
fi
grep -q '^VARIANT=' /etc/os-release || printf 'VARIANT="T2 Mac edition"\nVARIANT_ID=t2\n' >> /etc/os-release
systemctl enable t2fanrd.service iwd.service vitrea-t2-wifi-firmware.service
